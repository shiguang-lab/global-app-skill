{
  "name": "global-app-skill",
  "version": "0.1.8",
  "description": "Thin skill bootstrap and GitHub resource runner for overseas Android app research",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiguang-lab/global-app-skill.git"
  },
  "engines": { "node": ">=22.12.0" },
  "bin": { "global-app-skill": "src/cli.mjs" },
  "files": ["src", "skills"],
  "publishConfig": { "registry": "https://registry.npmjs.org/", "access": "public" },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest discover -s resources/global-app-analysis/scripts -p 'test_*.py'",
    "resources:build": "node scripts/build-resources.mjs",
    "resources:check": "node scripts/build-resources.mjs --check",
    "release:prepare": "node scripts/release.mjs",
    "prepublishOnly": "npm test && npm run test:python && npm run resources:build && npm run resources:check"
  }
}
